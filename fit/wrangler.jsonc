{
  // Deploy with: python3 build-worker.py && npx wrangler deploy
  // First time: npx wrangler kv namespace create MENU, paste its id below,
  // then npx wrangler secret put EDIT_KEY (your kitchen sync password).
  "name": "journey",
  "main": "dist/worker.js",
  "compatibility_date": "2026-09-01",
  "kv_namespaces": [{ "binding": "MENU", "id": "PASTE_KV_NAMESPACE_ID" }]
}
